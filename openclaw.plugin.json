{
  "id": "basecamp",
  "name": "Basecamp Channel",
  "version": "1.0.0",
  "description": "Basecamp 4 chatbot integration channel for OpenClaw",
  "channels": ["basecamp"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "webhookPath": {
        "type": "string",
        "default": "/basecamp/webhook"
      },
      "port": {
        "type": "number",
        "default": 3000
      }
    }
  },
  "uiHints": {
    "enabled": {
      "label": "Enable Basecamp Channel"
    },
    "webhookPath": {
      "label": "Webhook Path",
      "placeholder": "/basecamp/webhook"
    },
    "port": {
      "label": "Port",
      "placeholder": "3000"
    }
  }
}
